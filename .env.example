# AgencIA NTM — variáveis de ambiente de exemplo.
# Copie para .env e ajuste localmente. NUNCA versione o .env real.

# Aplicação
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Banco de dados (uso local fora do Docker)
DATABASE_URL=postgresql+psycopg://agenciantm:change-me-local@localhost:5432/agenciantm
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# PostgreSQL via Docker Compose
POSTGRES_USER=agenciantm
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=agenciantm
POSTGRES_PORT=5432

# Portas locais
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Autenticação — obrigatório a partir da FASE 2.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
NEXT_TELEMETRY_DISABLED=1
